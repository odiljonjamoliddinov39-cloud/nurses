# Backend / bot
DATABASE_URL=postgresql+asyncpg://nurses:nurses@postgres:5432/nurses
REDIS_URL=redis://redis:6379/0
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=123456789
S3_ENDPOINT=
S3_BUCKET=nurses
S3_ACCESS_KEY=
S3_SECRET_KEY=
STT_PROVIDER=stub
LLM_PROVIDER=stub
TTS_PROVIDER=stub
MINIAPP_URL=   # https URL of the Mini App (bot menu button); can also be set in admin Settings
PUBLIC_URL=    # https URL of this API for the Telegram webhook (Railway sets RAILWAY_PUBLIC_DOMAIN itself)

# Comma-separated frontend origins allowed by CORS (your Vercel URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local MinIO (compose); choose strong values
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
